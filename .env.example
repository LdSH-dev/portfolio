# Public URL of the deployed site. The live PageSpeed test audits this URL,
# so it stays disabled until it's set (e.g. https://leonardohemming.dev).
NEXT_PUBLIC_SITE_URL=

# Google Calendar appointment schedule booking page, e.g.
# https://calendar.google.com/calendar/appointments/schedules/AcZssZ...
# Without it, "Book a call" falls back to an email link.
NEXT_PUBLIC_BOOKING_URL=

# Optional but recommended: Google PageSpeed Insights API key (free).
# Unauthenticated requests get rate-limited quickly.
PSI_API_KEY=

# Server-only key for the "Ask my digital twin" chat (Claude Haiku 4.5).
# Set a monthly spend limit on the Anthropic Console.
ANTHROPIC_API_KEY=

# Custom booking picker (Google Calendar API). Without these, "Book a call"
# embeds Google's appointment page instead. Run `node scripts/google-auth.mjs`
# once to fill GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
